# Copy to .env.local and fill in.
NEXT_PUBLIC_PRIVY_APP_ID=
# StashFactory on Arc mainnet (from contracts/broadcast/Deploy.s.sol/5042/run-latest.json)
NEXT_PUBLIC_FACTORY_ARC=
# Stash service guardian address, added to every new vault
NEXT_PUBLIC_STASH_GUARDIAN=
# Vault the public /drain demo attacks when no ?vault= is given (read-only simulation)
NEXT_PUBLIC_DEMO_VAULT=
# Optional dedicated Arc RPC URL (QuickNode, dRPC, Blockdaemon…); defaults to https://rpc.mainnet.arc.io
NEXT_PUBLIC_RPC_ARC=
# Public GitHub repo URL (linked from "What this depends on")
NEXT_PUBLIC_REPO_URL=
# Server-only (never NEXT_PUBLIC): Privy app secret, used to mark recovery backups on the account
PRIVY_APP_SECRET=
# StashFactory on Arc testnet (from contracts/broadcast/DeployTestnetSavePot.s.sol/5042002/run-latest.json)
NEXT_PUBLIC_FACTORY_ARC_TESTNET=
# Demo vault for /drain on testnet (optional)
NEXT_PUBLIC_DEMO_VAULT_TESTNET=
