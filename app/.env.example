# Copy to .env.local and fill in.
NEXT_PUBLIC_PRIVY_APP_ID=
# Testnet and mainnet run in one app (header switch, testnet by default); set factories for both.
NEXT_PUBLIC_FACTORY_TEMPO_MODERATO=
NEXT_PUBLIC_FACTORY_TEMPO=
NEXT_PUBLIC_FACTORY_BASE_SEPOLIA=
NEXT_PUBLIC_FACTORY_BASE=
# Stash service guardian address (its key lives only in the worker)
NEXT_PUBLIC_STASH_GUARDIAN=
# Vault the public /drain demo attacks when no ?vault= is given (read-only simulation)
NEXT_PUBLIC_DEMO_VAULT=
# Same, on mainnet (optional; without it the mainnet drain test only runs on your own vault)
NEXT_PUBLIC_DEMO_VAULT_MAINNET=
# Optional dedicated RPC URLs (Alchemy, QuickNode…); public RPCs, Base's especially, rate-limit busy apps
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_BASE_SEPOLIA=
NEXT_PUBLIC_RPC_TEMPO=
NEXT_PUBLIC_RPC_TEMPO_MODERATO=
# Stand-alone exit page URL (hosted independently of the app, e.g. GitHub Pages)
NEXT_PUBLIC_EXIT_URL=
# Server-only (never NEXT_PUBLIC): Privy app secret, used to mark recovery backups on the account
PRIVY_APP_SECRET=
# Growth pot (Solana mainnet). A dedicated RPC (e.g. Helius) is much more reliable than the public one.
NEXT_PUBLIC_SOLANA_RPC=
# Max USD per Growth deposit during the beta
NEXT_PUBLIC_GROWTH_CAP_USD=25
# Public GitHub repo URL (linked from "What this pot depends on")
NEXT_PUBLIC_REPO_URL=
