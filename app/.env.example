# Copy to .env.local and fill in.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_HOME_NETWORK=tempoModerato
NEXT_PUBLIC_FACTORY_TEMPO_MODERATO=
NEXT_PUBLIC_FACTORY_TEMPO=
NEXT_PUBLIC_FACTORY_BASE_SEPOLIA=
NEXT_PUBLIC_FACTORY_BASE=
# Stash service guardian address (its key lives only in the worker)
NEXT_PUBLIC_STASH_GUARDIAN=
# Stand-alone exit page URL (hosted independently of the app, e.g. GitHub Pages)
NEXT_PUBLIC_EXIT_URL=
